# Copiez ce fichier en .env et remplissez les valeurs. Ne publiez jamais le fichier .env.

# Base PostgreSQL. En local avec docker compose : postgresql://buildsen:buildsen@db:5432/buildsen
# En production sur EC2 : fournie par docker-compose.prod.yml (voir DEPLOIEMENT-EC2.md)
DATABASE_URL=postgresql://buildsen:buildsen@localhost:5432/buildsen

# Adresse publique du site (liens dans les e-mails)
APP_URL=http://localhost:3000
# Origines autorisées pour les requêtes qui modifient des données (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000
# development ou production (en production : cookies « Secure », documentation /api/docs désactivée)
ENVIRONMENT=development

# E-mails (Resend). Laisser vide en développement : aucun e-mail n'est envoyé.
RESEND_API_KEY=
EMAIL_FROM=BUILDSEN <notifications@buildsen.com>

# Stockage des fichiers : par défaut sur le disque du serveur (dossier STORAGE_DIR, volume Docker en production), sans service externe.
# SUPABASE_URL / SUPABASE_SECRET_KEY : facultatifs, uniquement si vous préférez Supabase Storage (laisser vides sur un serveur EC2).
STORAGE_DIR=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Secret de la tâche planifiée /api/cron/alertes (en-tête Authorization: Bearer <secret>)
CRON_SECRET=
# Clé partagée avec le frontend pour ses appels serveur à serveur (même valeur que dans frontend/.env)
INTERNAL_API_KEY=

TRUST_PROXY=true

# Assistant vocal en wolof (Soynade AI, https://console.soynade.ai/api-keys). Clé utilisée uniquement par le serveur.
SOYNADE_API_KEY=

# --- Assistant WhatsApp (voir WHATSAPP.md) ---
# sim : simulateur local, sans compte Meta (interdit en production) · meta : API WhatsApp Cloud · off : désactivé
WHATSAPP_PROVIDER=sim
# Jeton de votre choix, à recopier dans la configuration du webhook chez Meta
WHATSAPP_VERIFY_TOKEN=
# Secret de l'application Meta (signature des messages reçus)
WHATSAPP_APP_SECRET=
# Jeton d'accès permanent (utilisateur système) et identifiant du numéro, depuis la console Meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Numéro public de l'assistant, 9 chiffres sans indicatif (lien et QR code du site)
WHATSAPP_BOT_NUMBER=

# --- Formules et paiement (voir WHATSAPP.md, sections 10 et 11) ---
# false : tout est gratuit et sans limite. true : limites de contacts par formule et paiement actifs (mettre aussi NEXT_PUBLIC_SHOW_PRICING=true au build du site)
PLANS_ENABLED=false
# sim : page de paiement de test, aucun argent (interdit en production) · paydunya : Wave et Orange Money · off
PAYMENT_PROVIDER=sim
# PayDunya (console : paydunya.com > Intégrer > Clés d'API). Mode « test » avec les clés de test, « live » avec les vraies clés
# Wave (lien de paiement marchand). PAYMENT_PROVIDER=wave pour l'utiliser. Le montant est ajouté au lien (?amount=).
# Wave ne prévient pas le serveur avec un simple lien : la formule ne s'active qu'à la réception de l'avis de paiement sur
# POST /api/payments/webhook/wave (en-tête X-Webhook-Secret, corps {amount, phone, reference}), retrouvé par montant + numéro Wave ; sinon l'équipe tranche.
# WAVE_GRACE_HOURS > 0 activerait la formule dès « J'ai payé » : déconseillé (contournable).
# Orange Money (lien marchand sugu.orange-sonatel.com) : PAYMENT_PROVIDER=links propose Wave et/ou Orange Money selon les liens renseignés.
OM_PAY_LINK=
OM_WEBHOOK_SECRET=
WAVE_PAY_LINK=
WAVE_WEBHOOK_SECRET=
WAVE_GRACE_HOURS=0
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
# Adresse du site sur le réseau local (téléphone) : renseignée par scripts/telephone.sh, ne pas remplir à la main
LAN_URL=

# --- Sécurité (voir RAPPORT-DE-SECURITE.md) ---
# Nombre de relais de confiance entre le visiteur et l'API (le site Next.js en est un). Sert à lire la vraie adresse dans X-Forwarded-For :
# 1 si l'API reçoit les appels du site directement ; 2 s'il y a aussi un répartiteur de charge devant l'API. À vérifier au premier déploiement.
PROXY_HOPS=1
# En production le serveur REFUSE de démarrer si CRON_SECRET ou INTERNAL_API_KEY font moins de 16 caractères, si ALLOWED_ORIGINS / APP_URL ne sont pas en https,
# ou si ADMIN_DEV_CODE / ADMIN_DEV_PASSWORD sont définis (réglages réservés au développement local).
